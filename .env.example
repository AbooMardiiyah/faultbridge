POSTGRES_DB=faultbridge
POSTGRES_USER=faultbridge
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://faultbridge:replace-with-a-local-password@localhost:5433/faultbridge
EVALUATION_DATABASE_URL=postgresql://faultbridge:replace-with-a-local-password@localhost:5433/faultbridge_eval
FAULTBRIDGE_PORT=8010
FAULTBRIDGE_DB_PORT=5433
FAULTBRIDGE_PSEUDONYM_SECRET=replace-with-a-random-secret-at-least-32-characters
FAULTBRIDGE_INTERNAL_API_KEY=replace-with-a-random-internal-key-at-least-32-characters
SAHARA_API_KEY=
SAHARA_STT_WS_URL=wss://infer.voice.intron.io/stt/v1/stream
SAHARA_TTS_WS_URL=wss://infer.voice.intron.io/tts/v1/stream
SAHARA_VOICEBOT_WORKFLOW_ID=
SAHARA_VOICEBOT_URL=https://voicebot.intron.health/voicebot/v1/convobot/call
STT_PROVIDER=sahara
TTS_PROVIDER=sahara
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-4.1-mini
AGENT_TIMEOUT_SECONDS=30

# Choose one LLM provider for transcript understanding and tool selection.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Operator action connectors. Commands remain queued until these are configured.
COMPENSATION_WEBHOOK_URL=
CALLBACK_WEBHOOK_URL=
OPERATOR_WEBHOOK_TOKEN=
TRANSCRIPT_RETENTION_DAYS=30

# Benchmark providers. Whisper runs locally and needs no key.
ASSEMBLYAI_API_KEY=
HF_TOKEN=
# HUGGINGFACE_TOKEN is also accepted as a backwards-compatible alternative.
HUGGINGFACE_TOKEN=

# Optional Twilio fallback if Sahara Conversation Call is unavailable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
