{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FaultBridge executable agent scenarios",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["scenario_id", "input", "expected"],
    "properties": {
      "scenario_id": {"type": "string", "minLength": 1},
      "input": {
        "type": "object",
        "required": ["caller_id", "transcript", "area", "cell_id", "language_pair", "consent"],
        "properties": {
          "caller_id": {"type": "string"},
          "transcript": {"type": "string"},
          "area": {"type": "string"},
          "cell_id": {"type": "string"},
          "language_pair": {"enum": ["Hausa-English", "Igbo-English", "Pidgin-English", "Yoruba-English"]},
          "consent": {"type": "boolean"},
          "resolved": {"type": "boolean"}
        },
        "additionalProperties": false
      },
      "hypotheses": {"type": "object", "additionalProperties": {"type": "string"}},
      "seed": {
        "type": "object",
        "properties": {
          "incidents": {"type": "array", "items": {"type": "object"}},
          "accounts": {"type": "array", "items": {"type": "object"}},
          "playbooks": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      },
      "expected": {"type": "object", "minProperties": 1},
      "expected_by_variant": {"type": "object", "additionalProperties": {"type": "object"}}
    },
    "additionalProperties": false
  }
}
